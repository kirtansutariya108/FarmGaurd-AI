# Application Environment
APP_NAME="FarmGuard AI"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_PREFIX=/api

# Demo / Mock Mode
# When true, fallbacks with realistic domain data are returned if ML weights or live weather keys are absent
DEMO_MODE=true

# Database (PostgreSQL / Supabase / SQLite for local testing)
# Example PostgreSQL: postgresql+psycopg2://postgres:password@localhost:5432/farmguard
# Example Supabase: postgresql+psycopg2://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./farmguard.db

# JWT Authentication
JWT_SECRET_KEY=change-this-in-production-use-a-secure-random-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ML Inference Configuration
DISEASE_MODEL_PATH=./models/disease_mobilenetv2.keras
DISEASE_LABELS_PATH=./app/ml/disease/labels.json
DISEASE_CONFIDENCE_THRESHOLD=0.60
IRRIGATION_MODEL_PATH=./models/irrigation_model.joblib

# External Weather Provider (Optional)
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# Storage
STORAGE_TYPE=local
STORAGE_DIR=./uploads
STORAGE_BUCKET=crop-scans
